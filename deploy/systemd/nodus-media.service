[Unit]
Description=Nodus Media, serving uploaded bytes and their variants.
Documentation=https://github.com/nodus-social/nodus-backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nodus
Group=nodus
EnvironmentFile=/etc/nodus-backend.env
Environment=NODUS_NODE_NAME=media
Environment=NODUS_BIND=0.0.0.0:3003
Environment=NODUS_TELEMETRY_SOCKET=/var/lib/nodus/run/media-telemetry.sock
ExecStart=/usr/local/bin/nodus-media
ReadWritePaths=/mnt/nodus-media /var/lib/nodus
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=nodus

[Install]
WantedBy=multi-user.target
