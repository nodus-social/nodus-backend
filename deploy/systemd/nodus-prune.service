[Unit]
Description=Nodus Deletes what has expired: media, sessions and codes.
Documentation=https://github.com/nodus-social/nodus-backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nodus
Group=nodus
EnvironmentFile=/etc/nodus-backend.env
Environment=NODUS_NODE_NAME=prune
Environment=NODUS_TELEMETRY_SOCKET=/var/lib/nodus/run/prune.sock
ReadWritePaths=/mnt/nodus-media /var/lib/nodus
ExecStart=/usr/local/bin/nodus-prune
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=nodus

[Install]
WantedBy=multi-user.target
