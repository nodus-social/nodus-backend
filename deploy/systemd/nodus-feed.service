[Unit]
Description=Nodus Recommendations, browsing and the sync surface.
Documentation=https://github.com/nodus-social/nodus-backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nodus
Group=nodus
EnvironmentFile=/etc/nodus-backend.env
Environment=NODUS_NODE_NAME=feed
Environment=NODUS_BIND=0.0.0.0:3002
Environment=NODUS_TELEMETRY_SOCKET=/var/lib/nodus/run/feed-telemetry.sock
ExecStart=/usr/local/bin/nodus-feed
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=nodus

[Install]
WantedBy=multi-user.target
